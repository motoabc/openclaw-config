27161000!@#468!@#62471807320\",\n      \"isFiltered\": \"0\",\n      \"poolLogoUrl\": \"https://static.coinall.ltd/cdn/web3/protocol/logo/1769510397050.png/type=png_350_0\",\n      \"price\": \"0.01875359056261876\",\n      \"time\": \"1777027161000\",\n      \"tokenContractAddress\": \"0xd5390300c5db71f80d46f0fa9983fc72d4d1e3da\",\n      \"txHashUrl\": \"0xb55709f3a12cbec9ee7fc800ed536ea1c80e808b2972a993f672a61f1167c515\",\n      \"type\": \"sell\",\n      \"userAddress\": \"0xbc85088c3f7f0c2d4462b1b0ce9b7663ac62034f\",\n      \"volume\": \"5.97373472493\"\n    },\n    {\n      \"chainIndex\": \"8453\",\n      \"changedTokenInfo\": [\n        {\n          \"amount\": \"5332.000000000000000000\",\n          \"tokenAddress\": \"0xd5390300c5db71f80d46f0fa9983fc72d4d1e3da\",\n          \"tokenSymbol\": \"KAT\"\n        },\n        {\n          \"amount\": \"99.834456\",\n          \"tokenAddress\": \"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913\",\n          \"tokenSymbol\": \"USDC\"\n        }\n      ],\n      \"dexName\": \"Aerodrome CL\",\n      \"id\": \"1777027161000!@#449!@#62471807304\",\n      \"isFiltered\": \"0\",\n      \"poolLogoUrl\": \"https://static.coinall.ltd/cdn/web3/protocol/logo/aerodrome-v3.png/type=png_350_0?v=1761877279383\",\n      \"price\": \"0.018719334972828207\",\n      \"time\": \"1777027161000\",\n      \"tokenContractAddress\": \"0xd5390300c5db71f80d46f0fa9983fc72d4d1e3da\",\n      \"txHashUrl\": \"0x61e5b42d378433caa9b39b66124b41a6a173c5c8568978c83ba2fe51712697b3\",\n      \"type\": \"sell\",\n      \"userAddress\": \"0xd0d08887e8a5b16049534a7f3fc1de92848f5bea\",\n      \"volume\": \"99.81149407512\"\n    },\n    {\n      \"chainIndex\": \"8453\",\n      \"changedTokenInfo\": [\n        {\n          \"amount\": \"5270.000000000000000000\",\n          \"tokenAddress\": \"0xd5390300c5db71f80d46f0fa9983fc72d4d1e3da\",\n          \"tokenSymbol\": \"KAT\"\n        },\n        {\n","name":"set ADDR=0xd5390300c5db71f80d46f0fa9983fc72d4d1e3da"},"