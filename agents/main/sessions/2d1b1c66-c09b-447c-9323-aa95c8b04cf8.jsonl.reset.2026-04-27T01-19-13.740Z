{"type":"message","id":"fd0796f3","parentId":"56bfb610","timestamp":"2026-04-25T02:35:53.086Z","message":{"role":"toolResult","toolCallId":"call_9NIfi2c0tjfiIOtPjFOHl6Vq","toolName":"web_search","content":[{"type":"text","text":"{\n  \"status\": \"error\",\n  \"tool\": \"web_search\",\n  \"error\": \"Gemini API error (403): {\\n  \\\"error\\\": {\\n    \\\"code\\\": 403,\\n    \\\"message\\\": \\\"Your API key was reported as leaked. Please use another API key.\\\",\\n    \\\"status\\\": \\\"PERMISSION_DENIED\\\"\\n  }\\n}\\n\"\n}"}],"details":{"status":"error","tool":"web_search","error":"Gemini API error (403): {\n  \"error\": {\n    \"code\": 403,\n    \"message\": \"Your API key was reported as leaked. Please use another API key.\",\n    \"status\": \"PERMISSION_DENIED\"\n  }\n}\n"},"isError":false,"timestamp":1777084553081}}
